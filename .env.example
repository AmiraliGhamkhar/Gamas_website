# =============================================================================
#  Gamas website — build-time environment (copy to .env.local or export)
#  -----------------------------------------------------------------------------
#  These are consumed by Vite at BUILD time only. They never run on cPanel and
#  no Node process is needed on the server. The source defaults already match
#  the production values below, so a plain `npm run build` is correct for
#  https://gamadesk.ir at the domain root.
# =============================================================================

# Canonical public origin (scheme + host only, no path/query/hash).
VITE_SITE_URL=https://gamadesk.ir

# Deploy path under the domain: "/" for public_html root, or "/subfolder/".
VITE_BASE=/

# Telegram bot username (no @, no https://t.me/). Defaults to Gamas_jozveh_bot.
VITE_BOT_USERNAME=Gamas_jozveh_bot

# Operator attestation only. Set to "true" ONLY after confirming that
# https://t.me/Gamas_jozveh_bot is the intended, live bot. It gates the
# Telegram `sameAs` edge in JSON-LD and the identity line in llms.txt; it is
# not an automated check. Leave unset/false otherwise.
# VITE_BOT_IDENTITY_VERIFIED=true

# Development/preview server ports (optional).
# PORT=5173
# PREVIEW_PORT=4173
