# =============================================================================
#  Gamas — /api hardening
#  Endpoints here are called with fetch() from the site, never browsed directly.
# =============================================================================

<IfModule mod_autoindex.c>
  Options -Indexes -MultiViews
</IfModule>

# The shared bootstrap only defines functions/constants — never allow a
# direct HTTP request to reach it (defence in depth if PHP ever fails to run).
<FilesMatch "(?i)^(bootstrap|config|lib)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Never serve dotfiles, raw config, logs, or data files that land next to the endpoints.
<FilesMatch "(?i)(?:^\.|\.(?:ini|log(?:\.[0-9]+)?|bak|old|orig|save|swp|sql|sqlite3?(?:-(?:wal|shm|journal))?|db(?:-(?:wal|shm|journal))?|json|ndjson|jsonl|md|yml|yaml|dist|example)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
  AddDefaultCharset UTF-8
</IfModule>

<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always unset X-Powered-By
  Header unset X-Content-Type-Options
  Header always set X-Content-Type-Options "nosniff"
  Header unset Referrer-Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Frame-Options
  Header always set X-Frame-Options "DENY"

  # CTA-tracker and retired-endpoint responses must never be cached.
  <FilesMatch "(?i)\.php$">
    Header unset Cache-Control
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
  </FilesMatch>
</IfModule>
