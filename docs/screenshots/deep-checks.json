    "lineHeight": "30.6px"
  },
  "vazirmatnLoaded": true,
  "lalezarLoaded": true,
  "buttonSpec": {
    "radius": "999px",
    "minH": "44px",
    "bg": "rgb(0, 102, 204)",
    "shadow": "none"
  },
  "focusRing": {
    "tag": "A",
    "text": "گگاماسGamas Bot",
    "outline": "rgb(0, 102, 204) solid 2px",
    "outlineColor": "rgb(0, 102, 204)"
  },
  "pressScale": {
    "hasActiveScaleRule": true
  },
  "drawerOpen": {
    "ariaExpanded": "true",
    "visible": true,
    "opacity": "1",
    "translate": "0px"
  },
  "drawerAfterEsc": {
    "ariaExpanded": "false",
    "visible": "hidden",
    "focusReturned": true
  },
  "formErrorState": {
    "role": "alert",
    "text": "اتصال امن برقرار نشد؛ صفحه را تازه‌سازی کنید."
  },
  "formInvalidState": {
    "role": "alert",
    "text": "نشانی ایمیل را به‌درستی وارد کنید."
  }
